# =============================================================================
# TOMCAT MANAGER — root .gitignore
# Covers: Python/FastAPI backend · Next.js frontend · Docker · shared tooling
# Rule: .env.example files are ALWAYS committed (they are templates, not secrets)
# =============================================================================


# =============================================================================
# 1. PYTHON ENVIRONMENT & PACKAGES
# =============================================================================

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# Python byte-code and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Installer artifacts
.Python

# Pipenv / Poetry
Pipfile.lock
poetry.lock


# =============================================================================
# 2. ENVIRONMENT & SECRETS  ← never commit real credentials
# =============================================================================

# Root-level env files
.env
.env.local
.env.*.local

# Backend env files (keep backend/.env.example)
backend/.env
backend/.env.local
backend/.env.*.local

# Frontend env files (keep frontend/.env.example)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/.env.*.local


# =============================================================================
# 3. NODE.JS & NEXT.JS
# =============================================================================

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Turbopack / Turbo cache
.turbo/

# Vercel deployment
.vercel/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript build info (generated, not needed in VCS)
*.tsbuildinfo

# Next.js auto-generated type declarations
next-env.d.ts


# =============================================================================
# 4. IDE & EDITOR FILES
# =============================================================================

# VS Code — allow .vscode/extensions.json (shared recommendations)
.vscode/*
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, IntelliJ…)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Cursor
.cursor/


# =============================================================================
# 5. OPERATING SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.TemporaryItems

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.Trash-*
.nfs*


# =============================================================================
# 6. DATABASE & CACHE
# =============================================================================

# SQLite (local dev databases)
*.db
*.sqlite
*.sqlite3

# PostgreSQL local data volumes
postgres_data/
pgdata/
pg_data/

# Redis
dump.rdb

# Celery
celerybeat-schedule
celerybeat.pid


# =============================================================================
# 7. LOGS & TEMPORARY FILES
# =============================================================================

# Log files (project creates these at runtime)
*.log
logs/

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# Temp/cache directories
temp/
tmp/
cache/
.cache/


# =============================================================================
# 8. SENSITIVE DATA & CREDENTIALS
# =============================================================================

# TLS / SSL certificates and private keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks

# SSH
.ssh/

# AWS credentials
.aws/

# Generic secrets directories
credentials/
secrets/
*.secret
*.secrets


# =============================================================================
# 9. BUILD & DIST OUTPUT
# =============================================================================

# Backend runtime directories (created when handling uploads/deploys)
backend/app/uploads/
backend/app/temp/

# Frontend build artifacts
frontend/dist/
frontend/build/
frontend/out/

# Coverage reports (generated by test runs)
coverage/
/coverage


# =============================================================================
# 10. TESTING & QUALITY TOOLS
# =============================================================================

# pytest
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/

# tox
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Hypothesis
.hypothesis/

# Ruff / flake8
.ruff_cache/

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache


# =============================================================================
# 11. DOCKER (runtime only — Dockerfiles and compose files ARE committed)
# =============================================================================

# Local Docker override files with secrets
docker-compose.override.yml
docker-compose.local.yml


# =============================================================================
# 12. ALEMBIC (migrations ARE committed — ignore only generated temp files)
# =============================================================================

# Nothing to ignore for Alembic — all migration files should be committed


# =============================================================================
# 13. MISCELLANEOUS PROJECT-SPECIFIC
# =============================================================================

# Security audit reports — never commit vulnerability details publicly
SECURITY_AUDIT.md
BUSINESS_LOGIC_SECURITY_UPDATE_PROMPT.md

# Uploaded WAR files (stored temporarily during deploy, not persisted)
*.war

# Python profiling
*.prof

# Rope project settings
.ropeproject

# pyenv
.python-version
