# =============================================================================
# FRONTEND — Next.js 14 / TypeScript / Tailwind CSS
# Root .gitignore also applies; this file adds Next.js-specific patterns.
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Vercel / Turbopack
.vercel/
.turbo/

# Environment files — keep .env.example (it is a template, not a secret)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# TypeScript compiler artifacts (generated, not source)
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.coverage

# ESLint / Prettier caches
.eslintcache
.prettiercache

# OS
.DS_Store
Thumbs.db
